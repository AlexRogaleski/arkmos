#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="/var/lib/arkmos"
STATE_FILE="${STATE_DIR}/initialized"

mkdir -p "$STATE_DIR"

if [[ -f "$STATE_FILE" ]]; then
    exit 0
fi

clear

echo
echo "=========================================="
echo "            BEM-VINDO AO ARKMOS"
echo "=========================================="
echo
echo "Configuração inicial do sistema."
echo

while true; do
    read -r -p "Nome de usuário: " USERNAME

    if [[ -z "$USERNAME" || "$USERNAME" == "root" ]]; then
        echo
        echo "Nome de usuário inválido."
        echo
        continue
    fi

    if id "$USERNAME" &>/dev/null; then
        echo
        echo "Esse usuário já existe."
        echo
        continue
    fi

    break
done

read -r -p "Nome completo: " FULLNAME

echo
echo "Criando usuário '$USERNAME'..."
echo

useradd \
    --create-home \
    --shell /usr/bin/zsh \
    --comment "$FULLNAME" \
    "$USERNAME"

usermod -aG wheel "$USERNAME"

echo
echo "Defina a senha do usuário:"
passwd "$USERNAME"

touch "$STATE_FILE"
chmod 600 "$STATE_FILE"

echo
echo "=========================================="
echo "       CONFIGURAÇÃO CONCLUÍDA"
echo "=========================================="
echo
echo "Usuário: $USERNAME"
echo "Home:    /home/$USERNAME"
echo
echo "O sistema será iniciado normalmente."
echo
echo "Pressione ENTER para continuar."
read -r
