#!/usr/bin/env bash
#
# Arkmos — diagnóstico da sessão gráfica.
#
# Existe porque a máquina de teste é uma VM sem área de transferência
# compartilhada: diagnosticar de fora significava digitar um comando de vinte
# linhas à mão. Aqui a resposta é curta e legível na tela.
#
# Rode DENTRO da sessão gráfica; fora dela, o que depende do compositor e do
# barramento da sessão aparece como ausente — o que é correto, não erro.

set -uo pipefail

ok()  { printf '  \033[32m✓\033[0m %-32s %s\n' "$1" "${2:-}"; }
nok() { printf '  \033[31m✗\033[0m %-32s %s\n' "$1" "${2:-}"; }

echo
echo "Arkmos — diagnóstico da sessão"
echo "=============================="
echo
echo "Ambiente"

[[ "${XDG_CURRENT_DESKTOP:-}" == *niri* ]] \
    && ok "XDG_CURRENT_DESKTOP" "$XDG_CURRENT_DESKTOP" \
    || nok "XDG_CURRENT_DESKTOP" "${XDG_CURRENT_DESKTOP:-VAZIO} — o portal ignora o niri-portals.conf"

[[ "${LANG:-}" == pt_BR* ]] && ok "LANG" "$LANG" || nok "LANG" "${LANG:-VAZIO}"

# O systemd --user arranca antes de qualquer login shell e é quem inicia os
# serviços da sessão; se LANG não chegou aqui, eles nascem em inglês.
if systemctl --user show-environment 2>/dev/null | grep -q '^LANG=pt_BR'; then
    ok "LANG no systemd --user"
else
    nok "LANG no systemd --user" "serviços da sessão ficam em inglês"
fi

echo
echo "Portais e tema"

for u in xdg-desktop-portal xdg-desktop-portal-gtk; do
    estado="$(systemctl --user is-active "$u" 2>/dev/null || true)"
    [[ "$estado" == active ]] && ok "$u" || nok "$u" "${estado:-inativo}"
done

# É por aqui que Firefox e aplicativos Electron perguntam se o sistema está no
# escuro. 1 = prefer-dark.
esquema="$(gdbus call --session \
    --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop \
    --method org.freedesktop.portal.Settings.ReadOne \
    org.freedesktop.appearance color-scheme 2>&1 || true)"
if [[ "$esquema" == *"uint32 1"* ]]; then
    ok "portal: color-scheme" "prefer-dark"
else
    nok "portal: color-scheme" "$(printf '%s' "$esquema" | tr -d '\n' | tail -c 55)"
fi

gs="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"
gs="${gs:-sem resposta}"
[[ "$gs" == *prefer-dark* ]] && ok "gsettings: color-scheme" "$gs" \
                             || nok "gsettings: color-scheme" "$gs"

gt="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)"
gt="${gt:-sem resposta}"
[[ "$gt" == *adw-gtk3-dark* ]] && ok "gsettings: gtk-theme" "$gt" \
                              || nok "gsettings: gtk-theme" "$gt"

echo
echo "Autenticação"

# Sem agente, toda ação que exige autorização falha sem mostrar nada.
pgrep -f polkit-mate-authentication-agent >/dev/null \
    && ok "agente polkit rodando" \
    || nok "agente polkit rodando" "autorizações falham em silêncio"

# O prompt pedindo a senha de novo depois do login é este, e a causa é o
# pam_gnome_keyring ausente.
[[ -e /usr/lib64/security/pam_gnome_keyring.so ]] \
    && ok "pam_gnome_keyring instalado" \
    || nok "pam_gnome_keyring instalado" "o chaveiro pedirá senha na sessão"

pgrep -x gcr-prompter >/dev/null \
    && nok "gcr-prompter ativo" "há prompt de chaveiro aberto agora" \
    || ok "nenhum prompt de chaveiro"

echo
echo "Aplicativos"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/Code/User/settings.json"
if [[ -s "$cfg" ]] && grep -q autoDetectColorScheme "$cfg"; then
    ok "VS Code: settings semeado" "via /etc/skel"
else
    nok "VS Code: settings semeado" "ausente ou sem autoDetectColorScheme"
fi

pgrep -x noctalia >/dev/null && ok "noctalia rodando" || nok "noctalia rodando"

echo
echo "Log de uma falha de login:"
echo "  journalctl -u greetd -b --no-pager | tail -40"
echo
